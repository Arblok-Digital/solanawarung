rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil & Wallet: User cuma bisa akses miliknya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Produk: Semua orang bisa liat, seller bisa buat/edit
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Orders & Transactions: Ditambah ijin delete buat cleaning data
    match /orders/{orderId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /transactions/{txId} {
      allow read, create: if request.auth != null;
    }

    match /escrow/{escrowId} {
      allow read, create, update: if request.auth != null;
    }
  }
}
